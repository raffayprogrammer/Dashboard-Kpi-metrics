# Postgres connection string for the existing Alfa Analytics database.
# This app only ever runs SELECT queries against it — no migrations, no writes.
#
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
#
# Examples:
#   Local Postgres:        postgresql://postgres:postgres@localhost:5432/alfa
#   Managed (Neon/Supabase/RDS, etc.): postgresql://user:password@host:5432/dbname?sslmode=require
DATABASE_URL=postgresql://user:password@host:port/database
